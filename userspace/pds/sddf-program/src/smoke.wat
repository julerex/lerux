(module
  (import "lerux" "read" (func $read (param i32 i32 i32 i32) (result i32)))
  (import "lerux" "socket" (func $socket (result i32)))
  (import "lerux" "log" (func $log (param i32 i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "/config/hostname")
  (data (i32.const 32) "lerux-wasm: ran\n")
  (func (export "start")
    (local $n i32)
    (local $fd i32)
    (local.set $fd (call $socket))
    (if (i32.ne (local.get $fd) (i32.const 3))
      (then (return)))
    (local.set $n (call $read (i32.const 0) (i32.const 16) (i32.const 64) (i32.const 8)))
    (if (i32.ne (local.get $n) (i32.const 5))
      (then (return)))
    (if (i32.ne (i32.load8_u (i32.const 64)) (i32.const 108))
      (then (return)))
    (if (i32.ne (i32.load8_u (i32.const 68)) (i32.const 120))
      (then (return)))
    (call $log (i32.const 32) (i32.const 16))))
