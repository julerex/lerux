<?xml version="1.0" encoding="UTF-8"?>
<!--
  Swift X SFX14-41G. The panel is the firmware framebuffer. The mode record
  page is filled by mb2-stub before seL4. There is no COM port. The built-in
  keyboard is the i8042. PCI locations are the Windows enumeration.
  Microkit allows 0xcf8 in one protection domain. The probe writes the six
  headers and sets bus master on the NVMe, xHCI, and MT7921 functions, and on
  the root port above the MT7921. Firmware assigned those base addresses. The
  other domains read that page. The shell is the fetch client: console-driver
  is its byte output, and swift_mt7921 occupies the network driver slot.
  Channel ids are support/profiles/swift.toml.
-->
<system>
    <memory_region name="mode_record" size="0x1000" phys_addr="0x1fe0000" />
    <memory_region name="framebuffer" size="{fb_bytes}" phys_addr="{fb_phys}" page_size="0x1000" />
    <memory_region name="pci_headers" size="0x1000" phys_addr="0x1fb0000" />
    <!-- Panel line ifdf00000. The probe excludes the low DMA windows here. -->
    <memory_region name="iommu_regs" size="0x4000" phys_addr="0xfdf00000" page_size="0x1000" />
    <!-- 0xfc82000000 is the header address. It is not a canonical virtual address. -->
    <memory_region name="mt7921_regs" size="0x200000" phys_addr="0xfc82000000" page_size="0x1000" />
    <memory_region name="nvme_regs" size="0x4000" phys_addr="0xd1500000" />
    <!-- 128 KiB below the header pages. The stub is linked at 32 MiB. -->
    <memory_region name="nvme_dma" size="0x20000" phys_addr="0x1f00000" />
    <memory_region name="xhci0_regs" size="0x10000" phys_addr="0xd1100000" />
    <memory_region name="xhci1_regs" size="0x10000" phys_addr="0xd1200000" />
    <!-- Next to the NVMe buffer. 0xf8000000 is the firmware hole, not RAM. -->
    <memory_region name="xhci_dma" size="0x40000" phys_addr="0x1f20000" />
    <!-- WFDMA rings. The xHCI window ends here. The header page starts at 0x1fb0000. -->
    <memory_region name="wifi_dma" size="0x40000" phys_addr="0x1f60000" />
    <!-- Starts where the WFDMA rings end. Byte 0 is 1 while the shell's browser owns the panel. -->
    <memory_region name="browser_hold" size="0x1000" phys_addr="0x1fa0000" />
    <memory_region name="disk_result" size="0x1000" phys_addr="0x1fc0000" />
    <!-- Between the disk result and the mode record. The radio still reads this page. -->
    <memory_region name="wifi_key" size="0x1000" phys_addr="0x1fd0000" />
    <!-- Fetch network queues. Addresses match lerux-sddf net_image. -->
    <memory_region name="net_rx_drv_free" size="0x1_000" />
    <memory_region name="net_rx_drv_active" size="0x1_000" />
    <memory_region name="net_tx_drv_free" size="0x1_000" />
    <memory_region name="net_tx_drv_active" size="0x1_000" />
    <memory_region name="net_rx_copy_free" size="0x1_000" />
    <memory_region name="net_rx_copy_active" size="0x1_000" />
    <memory_region name="net_rx_client_free" size="0x1_000" />
    <memory_region name="net_rx_client_active" size="0x1_000" />
    <memory_region name="net_tx_client_free" size="0x1_000" />
    <memory_region name="net_tx_client_active" size="0x1_000" />
    <memory_region name="net_rx_data" size="0x8_000" />
    <memory_region name="net_tx_data" size="0x8_000" />
    <memory_region name="net_rx_client_data" size="0x8_000" />
    <memory_region name="net_rx_meta" size="0x1_000" />

    <protection_domain name="console_driver" priority="6" stack_size="0x10_000">
        <program_image path="console-driver.elf" />
        <map mr="mode_record" vaddr="0x3fff0000" perms="r" cached="false" setvar_vaddr="mode_record_vaddr" />
        <map mr="framebuffer" vaddr="0x40000000" perms="rw" cached="false" setvar_vaddr="fb_vaddr" />
        <map mr="browser_hold" vaddr="0x3ffc0000" perms="rw" cached="true" setvar_vaddr="browser_hold_vaddr" />
        <ioport id="0" addr="0x60" size="1" setvar_id="kbd_data_ioport_id" setvar_addr="kbd_data_ioport_addr" />
        <ioport id="1" addr="0x64" size="1" setvar_id="kbd_cmd_ioport_id" setvar_addr="kbd_cmd_ioport_addr" />
        <irq pin="1" vector="49" id="0" trigger="edge" polarity="high" />
    </protection_domain>

    <protection_domain name="swift_pci_probe" priority="5" stack_size="0x10_000">
        <program_image path="swift-pci-probe.elf" />
        <map mr="mode_record" vaddr="0x3fff0000" perms="r" cached="false" setvar_vaddr="mode_record_vaddr" />
        <map mr="framebuffer" vaddr="0x40000000" perms="rw" cached="false" setvar_vaddr="fb_vaddr" />
        <map mr="pci_headers" vaddr="0x3ffd0000" perms="rw" cached="false" setvar_vaddr="pci_headers_vaddr" />
        <map mr="iommu_regs" vaddr="0xfdf00000" perms="rw" cached="false" setvar_vaddr="iommu_regs_vaddr" />
        <ioport id="0" addr="0xcf8" size="8" setvar_id="pci_ioport_id" setvar_addr="pci_ioport_addr" />
    </protection_domain>

    <protection_domain name="swift_mt7921" priority="4" stack_size="0x10_000">
        <program_image path="swift-mt7921.elf" />
        <map mr="mode_record" vaddr="0x3fff0000" perms="r" cached="false" setvar_vaddr="mode_record_vaddr" />
        <map mr="framebuffer" vaddr="0x40000000" perms="rw" cached="false" setvar_vaddr="fb_vaddr" />
        <map mr="pci_headers" vaddr="0x3ffd0000" perms="r" cached="false" setvar_vaddr="pci_headers_vaddr" />
        <map mr="mt7921_regs" vaddr="0x82000000" perms="rw" cached="false" setvar_vaddr="mt7921_regs_vaddr" />
        <map mr="wifi_dma" vaddr="0x1f60000" perms="rw" cached="false" setvar_vaddr="wifi_dma_vaddr" />
        <map mr="wifi_key" vaddr="0x1fd0000" perms="rw" cached="true" setvar_vaddr="wifi_key_vaddr" />
        <map mr="net_rx_drv_free" vaddr="0x5_000_000" perms="rw" cached="true" />
        <map mr="net_rx_drv_active" vaddr="0x5_001_000" perms="rw" cached="true" />
        <map mr="net_tx_drv_free" vaddr="0x5_002_000" perms="rw" cached="true" />
        <map mr="net_tx_drv_active" vaddr="0x5_003_000" perms="rw" cached="true" />
        <map mr="net_rx_data" vaddr="0x5_010_000" perms="rw" cached="true" />
        <map mr="net_tx_data" vaddr="0x5_020_000" perms="rw" cached="true" />
        <irq id="0" pcidev="03:00.0" handle="1" vector="51" />
    </protection_domain>

    <protection_domain name="swift_nvme" priority="3" stack_size="0x10_000">
        <program_image path="swift-nvme.elf" />
        <map mr="mode_record" vaddr="0x3fff0000" perms="r" cached="false" setvar_vaddr="mode_record_vaddr" />
        <map mr="framebuffer" vaddr="0x40000000" perms="rw" cached="false" setvar_vaddr="fb_vaddr" />
        <map mr="pci_headers" vaddr="0x3ffd0000" perms="r" cached="false" setvar_vaddr="pci_headers_vaddr" />
        <map mr="nvme_regs" vaddr="0xd1500000" perms="rw" cached="false" setvar_vaddr="nvme_regs_vaddr" />
        <map mr="nvme_dma" vaddr="0x3fe00000" perms="rw" cached="false" setvar_vaddr="nvme_dma_vaddr" />
        <map mr="disk_result" vaddr="0x3ffe0000" perms="rw" cached="true" setvar_vaddr="disk_result_vaddr" />
        <irq id="0" pcidev="02:00.0" handle="1" vector="52" />
    </protection_domain>

    <protection_domain name="swift_bt" priority="2" stack_size="0x10_000">
        <program_image path="swift-bt.elf" />
        <map mr="mode_record" vaddr="0x3fff0000" perms="r" cached="false" setvar_vaddr="mode_record_vaddr" />
        <map mr="framebuffer" vaddr="0x40000000" perms="rw" cached="false" setvar_vaddr="fb_vaddr" />
        <map mr="pci_headers" vaddr="0x3ffd0000" perms="r" cached="false" setvar_vaddr="pci_headers_vaddr" />
        <map mr="xhci0_regs" vaddr="0xd1100000" perms="rw" cached="false" setvar_vaddr="xhci0_regs_vaddr" />
        <map mr="xhci1_regs" vaddr="0xd1200000" perms="rw" cached="false" setvar_vaddr="xhci1_regs_vaddr" />
        <map mr="xhci_dma" vaddr="0x1f20000" perms="rw" cached="false" setvar_vaddr="xhci_dma_vaddr" />
        <irq id="0" pcidev="04:00.3" handle="1" vector="53" />
        <irq id="1" pcidev="04:00.4" handle="2" vector="54" />
    </protection_domain>

    <protection_domain name="net_virt_tx" priority="3" stack_size="0x10_000">
        <program_image path="sddf-net-virt-tx.elf" />
        <map mr="net_tx_drv_free" vaddr="0x5_002_000" perms="rw" cached="true" />
        <map mr="net_tx_drv_active" vaddr="0x5_003_000" perms="rw" cached="true" />
        <map mr="net_tx_client_free" vaddr="0x5_008_000" perms="rw" cached="true" />
        <map mr="net_tx_client_active" vaddr="0x5_009_000" perms="rw" cached="true" />
        <map mr="net_tx_data" vaddr="0x5_020_000" perms="rw" cached="true" />
    </protection_domain>

    <protection_domain name="net_virt_rx" priority="3" stack_size="0x10_000">
        <program_image path="sddf-net-virt-rx.elf" />
        <map mr="net_rx_drv_free" vaddr="0x5_000_000" perms="rw" cached="true" />
        <map mr="net_rx_drv_active" vaddr="0x5_001_000" perms="rw" cached="true" />
        <map mr="net_rx_copy_free" vaddr="0x5_004_000" perms="rw" cached="true" />
        <map mr="net_rx_copy_active" vaddr="0x5_005_000" perms="rw" cached="true" />
        <map mr="net_rx_data" vaddr="0x5_010_000" perms="rw" cached="true" />
        <map mr="net_rx_meta" vaddr="0x5_040_000" perms="rw" cached="true" />
    </protection_domain>

    <protection_domain name="net_copy" priority="2" stack_size="0x10_000">
        <program_image path="sddf-net-copy.elf" />
        <map mr="net_rx_copy_free" vaddr="0x5_004_000" perms="rw" cached="true" />
        <map mr="net_rx_copy_active" vaddr="0x5_005_000" perms="rw" cached="true" />
        <map mr="net_rx_data" vaddr="0x5_010_000" perms="rw" cached="true" />
        <map mr="net_rx_client_free" vaddr="0x5_006_000" perms="rw" cached="true" />
        <map mr="net_rx_client_active" vaddr="0x5_007_000" perms="rw" cached="true" />
        <map mr="net_rx_client_data" vaddr="0x5_030_000" perms="rw" cached="true" />
    </protection_domain>

    <protection_domain name="shell" priority="1" stack_size="0x10_000">
        <program_image path="sddf-shell.elf" />
        <!-- The fetch shell sends bytes to console_driver. It does not read these pages. -->
        <map mr="mode_record" vaddr="0x3fff0000" perms="r" cached="false" />
        <map mr="framebuffer" vaddr="0x40000000" perms="rw" cached="false" />
        <map mr="browser_hold" vaddr="0x3ffc0000" perms="rw" cached="true" />
        <map mr="disk_result" vaddr="0x3ffe0000" perms="r" cached="true" />
        <map mr="wifi_key" vaddr="0x1fd0000" perms="rw" cached="true" />
        <map mr="net_rx_client_free" vaddr="0x5_006_000" perms="rw" cached="true" />
        <map mr="net_rx_client_active" vaddr="0x5_007_000" perms="rw" cached="true" />
        <map mr="net_tx_client_free" vaddr="0x5_008_000" perms="rw" cached="true" />
        <map mr="net_tx_client_active" vaddr="0x5_009_000" perms="rw" cached="true" />
        <map mr="net_rx_client_data" vaddr="0x5_030_000" perms="rw" cached="true" />
        <map mr="net_tx_data" vaddr="0x5_020_000" perms="rw" cached="true" />
    </protection_domain>

    <channel>
        <end pd="console_driver" id="1" />
        <end pd="shell" id="0" pp="true" />
    </channel>
    <channel>
        <end pd="swift_nvme" id="1" />
        <end pd="shell" id="1" />
    </channel>
    <channel>
        <end pd="swift_mt7921" id="1" />
        <end pd="net_virt_rx" id="0" />
    </channel>
    <channel>
        <end pd="swift_mt7921" id="2" />
        <end pd="net_virt_tx" id="0" />
    </channel>
    <channel>
        <end pd="net_virt_rx" id="1" />
        <end pd="net_copy" id="0" />
    </channel>
    <channel>
        <end pd="net_copy" id="1" />
        <end pd="shell" id="3" />
    </channel>
    <channel>
        <end pd="net_virt_tx" id="1" />
        <end pd="shell" id="4" />
    </channel>
</system>
