<?xml version="1.0" encoding="UTF-8"?>
<!--
  On-screen menu for the Z97 desk: the firmware buffer at 0xd0000000,
  PS/2 or a USB HID boot keyboard, COM1 for the same bytes, and the
  RTL8852BE BAR 2. The shell's channel 0 speaks the serial byte protocol
  to console_driver. Channel 1 speaks it to serial_driver. xHCI registers
  sit at the Z97 BAR. The DMA window is RAM. rtl8852be owns BAR 2.
  console_driver writes the config page. The shell reads the status page.
-->
<system>
    <memory_region name="mode_record" size="0x1000" phys_addr="0x1fe0000" />
    <memory_region name="desk_fb" size="0x300000" phys_addr="0xd0000000" page_size="0x1000" />
    <memory_region name="xhci_regs" size="0x1_0000" phys_addr="0xf7e2_0000" />
    <memory_region name="xhci_dma" size="0x4_0000" phys_addr="0x6200_0000" />
    <memory_region name="rtl8852be_mmio" size="0x10_0000" phys_addr="0xf7c0_0000" />
    <memory_region name="rtl8852be_status" size="0x1000" phys_addr="0x6240_0000" />
    <memory_region name="rtl8852be_cfg" size="0x1000" phys_addr="0x6250_0000" />

    <protection_domain name="serial_driver" priority="10" stack_size="0x10_000">
        <program_image path="serial-driver.elf" />
        <ioport id="0" addr="{serial_ioport_addr}" size="8" setvar_id="com1_ioport_id" setvar_addr="com1_ioport_addr" />
        <irq pin="{serial_ioapic_pin}" vector="{serial_ioapic_vector}" id="0" trigger="level" polarity="low" />
    </protection_domain>

    <!-- Above the shell so the shell may call it. -->
    <protection_domain name="console_driver" priority="4" stack_size="0x10_000">
        <program_image path="console-driver.elf" />
        <map mr="mode_record" vaddr="0x3fff0000" perms="rw" cached="false" setvar_vaddr="mode_record_vaddr" />
        <map mr="desk_fb" vaddr="0x40000000" perms="rw" cached="false" setvar_vaddr="desk_fb_vaddr" />
        <map mr="xhci_regs" vaddr="0xf7e2_0000" perms="rw" cached="false" setvar_vaddr="xhci_regs_vaddr" />
        <map mr="xhci_dma" vaddr="0x6200_0000" perms="rw" cached="false" setvar_vaddr="xhci_dma_vaddr" />
        <map mr="rtl8852be_cfg" vaddr="0x6250_0000" perms="rw" cached="false" setvar_vaddr="rtl8852be_cfg_vaddr" />
        <ioport id="0" addr="0x60" size="1" setvar_id="kbd_data_ioport_id" setvar_addr="kbd_data_ioport_addr" />
        <ioport id="1" addr="0x64" size="1" setvar_id="kbd_cmd_ioport_id" setvar_addr="kbd_cmd_ioport_addr" />
        <ioport id="2" addr="0xcf8" size="8" setvar_id="pci_ioport_id" setvar_addr="pci_ioport_addr" />
        <!-- ISA IRQ1, edge. COM1 keeps pin 4 / vector 48. -->
        <irq pin="1" vector="49" id="0" trigger="edge" polarity="high" />
        <!-- xHCI MSI. Userspace programs data vector 50 + IRQ_OFFSET (98). -->
        <irq id="2" pcidev="00:14.0" handle="1" vector="50" />
    </protection_domain>

    <protection_domain name="rtl8852be" priority="3" stack_size="0x10_000">
        <program_image path="rtl8852be-driver.elf" />
        <map mr="rtl8852be_mmio" vaddr="0xf7c0_0000" perms="rw" cached="false" setvar_vaddr="rtl8852be_mmio_vaddr" />
        <map mr="rtl8852be_cfg" vaddr="0x6250_0000" perms="r" cached="false" setvar_vaddr="rtl8852be_cfg_vaddr" />
        <map mr="rtl8852be_status" vaddr="0x6240_0000" perms="rw" cached="false" setvar_vaddr="rtl8852be_status_vaddr" />
    </protection_domain>

    <protection_domain name="shell" priority="1" stack_size="0x10_000">
        <program_image path="console-shell.elf" />
        <map mr="rtl8852be_status" vaddr="0x6240_0000" perms="r" cached="false" setvar_vaddr="rtl8852be_status_vaddr" />
    </protection_domain>

    <channel>
        <end pd="console_driver" id="1" />
        <end pd="shell" id="0" pp="true" />
    </channel>

    <channel>
        <end pd="serial_driver" id="1" />
        <end pd="shell" id="1" pp="true" />
    </channel>
</system>
