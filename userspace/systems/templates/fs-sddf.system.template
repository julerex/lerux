<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="virtio_mmio" size="0x1_000" phys_addr="{virtio_mmio_phys_addr}" />
    <memory_region name="virtio_blk_driver_dma" size="0x200_000" page_size="0x200_000" />

    <memory_region name="blk_storage_info" size="0x1_000" />
    <memory_region name="blk_driver_req_queue" size="0x1_000" />
    <memory_region name="blk_driver_resp_queue" size="0x1_000" />
    <memory_region name="blk_client_req_queue" size="0x1_000" />
    <memory_region name="blk_client_resp_queue" size="0x1_000" />
    <memory_region name="blk_data" size="0x10_000" />

    <memory_region name="fs_command_queue" size="0x8_000" />
    <memory_region name="fs_completion_queue" size="0x8_000" />
    <memory_region name="fs_share" size="0x8_000" />

    <protection_domain name="blk_driver" priority="4" stack_size="0x10_000">
        <program_image path="sddf-blk-driver.elf" />
        <map mr="virtio_mmio" vaddr="0x6_000_000_000" perms="rw" cached="false" setvar_vaddr="virtio_blk_mmio_vaddr" />
        <map mr="virtio_blk_driver_dma" vaddr="0x8_000_000_000" perms="rw" cached="true" setvar_vaddr="virtio_blk_driver_dma_vaddr" />
        <setvar symbol="virtio_blk_driver_dma_paddr" region_paddr="virtio_blk_driver_dma" />
        <map mr="blk_storage_info" vaddr="0x3_000_000" perms="rw" cached="true" />
        <map mr="blk_driver_req_queue" vaddr="0x3_001_000" perms="rw" cached="true" />
        <map mr="blk_driver_resp_queue" vaddr="0x3_002_000" perms="rw" cached="true" />
        <map mr="blk_data" vaddr="0x3_010_000" perms="rw" cached="true" />
        <irq irq="{virtio_blk_irq}" id="0" />
    </protection_domain>

    <protection_domain name="blk_virt" priority="3" stack_size="0x10_000">
        <program_image path="sddf-blk-virt.elf" />
        <map mr="blk_storage_info" vaddr="0x3_000_000" perms="rw" cached="true" />
        <map mr="blk_driver_req_queue" vaddr="0x3_001_000" perms="rw" cached="true" />
        <map mr="blk_driver_resp_queue" vaddr="0x3_002_000" perms="rw" cached="true" />
        <map mr="blk_client_req_queue" vaddr="0x3_003_000" perms="rw" cached="true" />
        <map mr="blk_client_resp_queue" vaddr="0x3_004_000" perms="rw" cached="true" />
    </protection_domain>

    <protection_domain name="fatfs" priority="2" stack_size="0x10_000">
        <program_image path="sddf-fatfs.elf" />
        <map mr="blk_storage_info" vaddr="0x3_000_000" perms="rw" cached="true" />
        <map mr="blk_client_req_queue" vaddr="0x3_003_000" perms="rw" cached="true" />
        <map mr="blk_client_resp_queue" vaddr="0x3_004_000" perms="rw" cached="true" />
        <map mr="blk_data" vaddr="0x3_010_000" perms="rw" cached="true" />
        <map mr="fs_command_queue" vaddr="0x3_020_000" perms="rw" cached="true" />
        <map mr="fs_completion_queue" vaddr="0x3_028_000" perms="rw" cached="true" />
        <map mr="fs_share" vaddr="0x3_030_000" perms="rw" cached="true" />
    </protection_domain>

    <protection_domain name="fs_client" priority="1" stack_size="0x10_000">
        <program_image path="sddf-fs-client.elf" />
        <map mr="fs_command_queue" vaddr="0x3_020_000" perms="rw" cached="true" />
        <map mr="fs_completion_queue" vaddr="0x3_028_000" perms="rw" cached="true" />
        <map mr="fs_share" vaddr="0x3_030_000" perms="rw" cached="true" />
    </protection_domain>

    <channel>
        <end pd="blk_driver" id="1" />
        <end pd="blk_virt" id="0" />
    </channel>
    <channel>
        <end pd="blk_virt" id="1" />
        <end pd="fatfs" id="0" />
    </channel>
    <channel>
        <end pd="fatfs" id="1" />
        <end pd="fs_client" id="0" />
    </channel>
</system>
