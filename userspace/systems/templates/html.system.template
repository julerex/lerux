<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase 74: html-demo parses a baked-in support/browser fixture and logs
  node count. No NIC, no FS — static &[u8] via include_str.
-->
<system>
    <memory_region name="serial_mmio" size="0x1_000" phys_addr="{serial_mmio_phys_addr}" />

    <protection_domain name="serial_driver" priority="2" stack_size="0x10_000">
        <program_image path="serial-driver.elf" />
        <map mr="serial_mmio" vaddr="0x2_000_000" perms="rw" setvar_vaddr="serial_register_block" />
        <irq irq="{serial_irq}" id="0" />
    </protection_domain>

    <protection_domain name="html_demo" priority="1" stack_size="0x20_000">
        <program_image path="html-demo.elf" />
    </protection_domain>

    <channel>
        <end pd="serial_driver" id="1" />
        <end pd="html_demo" id="0" pp="true" />
    </channel>
</system>
